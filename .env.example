# Build-time config for src/build.py (read automatically; real env vars win).
# Copy to .env and fill in. .env is git-ignored.

# Paddle web checkout. Leave PADDLE_CLIENT_TOKEN empty to build WITHOUT Paddle:
# the site then keeps the backend checkout flow (POST /billing/checkout).
PADDLE_ENV=sandbox
# Client-side token, NOT an API key. Sandbox: test_...  Live: live_...
# Paddle > Developer tools > Authentication > Client-side tokens.
# The build refuses a pdl_ API key and a prefix that does not match PADDLE_ENV.
PADDLE_CLIENT_TOKEN=
# Price ids printed by ../mizan-app/backend/scripts/seed-paddle-catalog.mjs.
# Sandbox and live ids differ; swap all six when switching PADDLE_ENV.
PADDLE_PRICE_BASIC_MONTHLY=
PADDLE_PRICE_BASIC_YEARLY=
PADDLE_PRICE_SMART_MONTHLY=
PADDLE_PRICE_SMART_YEARLY=
PADDLE_PRICE_PRO_AI_MONTHLY=
PADDLE_PRICE_PRO_AI_YEARLY=

# Optional: point the site at another API (local testing).
# MIZAN_API_BASE=http://localhost:3002
